[Unit]
Description=WireGuard auto-connect
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/wireguard/wireguard.env
ExecStart=/usr/local/bin/wireguard.sh autoconnect
ExecStop=/usr/local/bin/wireguard.sh disconnect
TimeoutStartSec=45

[Install]
WantedBy=multi-user.target
